{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe сборка активного файла",
            "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}", // это main.cpp
                "${workspaceFolder}/modules/system.cpp", // ДОБАВИТЬ
                "${workspaceFolder}/modules/list.cpp",   // ДОБАВИТЬ
                "-I", "${workspaceFolder}/modules",      // ДОБАВИТЬ (чтобы находил .hpp)
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "компилятор: C:\\msys64\\mingw64\\bin\\g++.exe"
        }
    ]
}